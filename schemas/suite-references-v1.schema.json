{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zeroslack.local/schemas/suite-references-v1.schema.json",
  "title": "ZeroSlack Suite References",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "resources"],
  "properties": {
    "schema": {
      "const": "zeroslack.suite-references/v1"
    },
    "resources": {
      "type": "array",
      "maxItems": 512,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "provider", "file"],
        "properties": {
          "id": {"type": "string", "minLength": 1, "maxLength": 160},
          "provider": {"enum": ["wave", "regmap"]},
          "file": {"type": "string", "minLength": 1, "maxLength": 4096},
          "uri": {"type": "string", "maxLength": 4096},
          "title": {"type": "string", "maxLength": 160},
          "summary": {"type": "string", "maxLength": 512},
          "objectId": {"type": "string", "maxLength": 256},
          "symbols": {
            "type": "array",
            "maxItems": 64,
            "items": {"type": "string", "maxLength": 256}
          },
          "metadata": {"type": "object"}
        }
      }
    }
  }
}
