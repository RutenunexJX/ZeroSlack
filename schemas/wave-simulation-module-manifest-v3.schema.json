{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zeroslack.local/schema/wave-simulation-module-manifest-v3.schema.json",
  "title": "ZeroSlack Wave Simulation Module Manifest v3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "workspaceId", "target", "observationScope",
    "observations", "sources", "includeDirs", "defines", "parameters",
    "ports", "clockCandidates", "resetCandidates"
  ],
  "properties": {
    "schemaVersion": { "const": 3 },
    "workspaceId": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "target": { "$ref": "#/$defs/target" },
    "observationScope": { "$ref": "#/$defs/observationScope" },
    "observations": {
      "type": "array",
      "items": { "$ref": "#/$defs/observation" }
    },
    "sources": {
      "type": "array",
      "items": { "$ref": "#/$defs/source" },
      "uniqueItems": true
    },
    "includeDirs": {
      "type": "array",
      "items": { "$ref": "#/$defs/relativePath" },
      "uniqueItems": true
    },
    "defines": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "parameters": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/parameter" }
    },
    "ports": {
      "type": "array",
      "items": { "$ref": "#/$defs/port" }
    },
    "clockCandidates": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "resetCandidates": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    }
  },
  "$defs": {
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "not": {
        "anyOf": [
          { "pattern": "^[A-Za-z]:" },
          { "pattern": "^/" },
          { "pattern": "(^|/)\\.\\.(/|$)" }
        ]
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "module", "instancePath", "sourceFile", "sourceLine"],
      "properties": {
        "mode": { "enum": ["module-definition", "instance"] },
        "module": { "type": "string", "minLength": 1 },
        "instancePath": { "type": "string" },
        "sourceFile": { "$ref": "#/$defs/relativePath" },
        "sourceLine": { "type": "integer", "minimum": 1 }
      }
    },
    "observationScope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "label", "sourceFile", "startLine", "endLine"],
      "properties": {
        "mode": { "enum": ["module", "always"] },
        "label": { "type": "string" },
        "sourceFile": { "$ref": "#/$defs/relativePath" },
        "startLine": { "type": "integer", "minimum": 0 },
        "endLine": { "type": "integer", "minimum": 0 }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "role"],
      "properties": {
        "path": { "$ref": "#/$defs/relativePath" },
        "role": { "enum": ["design", "header", "external-header", "generated", "unknown"] }
      }
    },
    "typeShape": {
      "type": "object",
      "required": [
        "semanticAvailable", "rawTypeText", "resolvedTypeName", "semanticKind",
        "resolvedTypeText", "canonicalTypeId", "declarationShapeId", "fixedSize",
        "integral", "signed", "unpackedArray", "interfaceType", "bitWidth",
        "packedDimensions", "unpackedDimensions", "unpackedElementCount",
        "interfaceName", "modportName", "typedefChain", "failureReason"
      ],
      "properties": {
        "semanticAvailable": { "type": "boolean" },
        "rawTypeText": { "type": "string" },
        "resolvedTypeName": { "type": "string" },
        "semanticKind": { "type": "string" },
        "resolvedTypeText": { "type": "string" },
        "canonicalTypeId": { "type": "string" },
        "declarationShapeId": { "type": "string" },
        "fixedSize": { "type": "boolean" },
        "integral": { "type": "boolean" },
        "signed": { "type": "boolean" },
        "unpackedArray": { "type": "boolean" },
        "interfaceType": { "type": "boolean" },
        "bitWidth": { "type": "integer", "minimum": 0 },
        "packedDimensions": { "type": "string" },
        "unpackedDimensions": { "type": "string" },
        "unpackedElementCount": { "type": "string" },
        "interfaceName": { "type": "string" },
        "modportName": { "type": "string" },
        "typedefChain": { "type": "array", "items": { "type": "string" } },
        "failureReason": { "type": "string" }
      }
    },
    "type": {
      "allOf": [
        { "$ref": "#/$defs/typeShape" },
        {
          "type": "object",
          "required": ["enumValues", "structMembers"],
          "properties": {
            "enumValues": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["name", "declarationText", "valueText", "displayValueText", "semanticAvailable"],
                "properties": {
                  "name": { "type": "string", "minLength": 1 },
                  "declarationText": { "type": "string" },
                  "valueText": { "type": "string" },
                  "displayValueText": { "type": "string" },
                  "semanticAvailable": { "type": "boolean" }
                }
              }
            },
            "structMembers": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["name", "declarationText", "type"],
                "properties": {
                  "name": { "type": "string", "minLength": 1 },
                  "declarationText": { "type": "string" },
                  "type": { "$ref": "#/$defs/typeShape" }
                }
              }
            }
          }
        }
      ]
    },
    "parameter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "declarationText", "expressionText", "valueText", "displayValueText", "semanticAvailable", "type", "sourceFile", "sourceLine"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "declarationText": { "type": "string" },
        "expressionText": { "type": "string" },
        "valueText": { "type": "string" },
        "displayValueText": { "type": "string" },
        "semanticAvailable": { "type": "boolean" },
        "type": { "$ref": "#/$defs/type" },
        "sourceFile": { "$ref": "#/$defs/relativePath" },
        "sourceLine": { "type": "integer", "minimum": 1 }
      }
    },
    "structuredSelector": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "name", "sourceIndex", "storageIndex"],
      "properties": {
        "kind": { "enum": ["struct-member", "packed-index", "unpacked-index", "interface-member"] },
        "name": { "type": "string" },
        "sourceIndex": { "type": "integer" },
        "storageIndex": { "type": "integer", "minimum": 0 }
      }
    },
    "editableLeaf": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "relativePath", "direction", "selectors", "type", "enumValues",
        "packedBitOffsetValid", "packedBitOffset"
      ],
      "properties": {
        "relativePath": { "type": "string", "minLength": 1 },
        "direction": { "enum": ["", "input", "output", "inout", "ref"] },
        "selectors": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/structuredSelector" }
        },
        "type": { "$ref": "#/$defs/typeShape" },
        "enumValues": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "declarationText", "valueText", "displayValueText", "semanticAvailable"],
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "declarationText": { "type": "string" },
              "valueText": { "type": "string" },
              "displayValueText": { "type": "string" },
              "semanticAvailable": { "type": "boolean" }
            }
          }
        },
        "packedBitOffsetValid": { "type": "boolean" },
        "packedBitOffset": { "type": "integer", "minimum": 0 }
      }
    },
    "port": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name", "direction", "declarationText", "type",
        "structuredLeavesAvailable", "editableLeaves", "structuredFailureReason",
        "sourceFile", "sourceLine"
      ],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "direction": { "enum": ["input", "output", "inout", "ref", "interface", "unknown"] },
        "declarationText": { "type": "string" },
        "type": { "$ref": "#/$defs/type" },
        "structuredLeavesAvailable": { "type": "boolean" },
        "editableLeaves": {
          "type": "array",
          "items": { "$ref": "#/$defs/editableLeaf" }
        },
        "structuredFailureReason": { "type": "string" },
        "sourceFile": { "$ref": "#/$defs/relativePath" },
        "sourceLine": { "type": "integer", "minimum": 1 }
      }
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "accessPath", "semanticId", "declarationText", "type", "sourceFile", "sourceLine", "port"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "accessPath": { "type": "string", "minLength": 1 },
        "semanticId": { "type": "string", "minLength": 1 },
        "declarationText": { "type": "string" },
        "type": { "$ref": "#/$defs/type" },
        "sourceFile": { "$ref": "#/$defs/relativePath" },
        "sourceLine": { "type": "integer", "minimum": 1 },
        "port": { "type": "boolean" }
      }
    }
  }
}
