set(phase_i4_semantic_index_missing_files)
set(phase_i4_semantic_index_violations)
foreach(relative_path IN LISTS PHASE_I4_NATIVE_SEMANTIC_INDEX_FILES)
    set(path "${ZEROSLACK_SOURCE_DIR}/${relative_path}")
    if(NOT EXISTS "${path}")
        list(APPEND phase_i4_semantic_index_missing_files "${relative_path}")
        continue()
    endif()
    file(READ "${path}" content)
    string(REGEX MATCH
        "(setSymbolDatabase[ \t\r\n]*\\(|symbolDatabase[ \t\r\n]*\\([ \t\r\n]*\\)|m_symbolDatabase|SemanticIndex[ \t\r\n]*\\([ \t\r\n]*sym_list[ \t\r\n]*\\*)"
        legacy_semantic_index_match
        "${content}")

    if(legacy_semantic_index_match)
        list(APPEND phase_i4_semantic_index_violations
             "${relative_path}: ${legacy_semantic_index_match}")
    endif()
endforeach()

