set(missing_files)
set(violations)
foreach(relative_path IN LISTS PROTECTED_BOUNDARY_FILES)
    set(path "${ZEROSLACK_SOURCE_DIR}/${relative_path}")
    if(NOT EXISTS "${path}")
        list(APPEND missing_files "${relative_path}")
        continue()
    endif()

    file(READ "${path}" content)
    string(REGEX MATCHALL
        "\\.(symbolId|symbolType|moduleScope|dataType)([^A-Za-z0-9_]|$)"
        field_matches
        "${content}")
    string(REGEX MATCHALL
        "[A-Za-z0-9_]+\\.symbol\\.symbolName([^A-Za-z0-9_]|$)"
        symbol_payload_name_matches
        "${content}")
    string(REGEX MATCHALL
        "(^|[^A-Za-z0-9_])sym_type_e([^A-Za-z0-9_]|$)|(^|[^A-Za-z0-9_])sym_list::sym_[A-Za-z0-9_]+([^A-Za-z0-9_]|$)"
        enum_matches
        "${content}")
    string(REGEX MATCHALL
        "(^|[^A-Za-z0-9_])(findSymbolId|getSymbolById|getRelationships)[ \t\r\n]*\\("
