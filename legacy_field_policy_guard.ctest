set(h0_allowlist_missing_files)
foreach(relative_path IN LISTS H0_LEGACY_CORE_ALLOWLIST)
    set(path "${ZEROSLACK_SOURCE_DIR}/${relative_path}")
    if(NOT EXISTS "${path}")
        list(APPEND h0_allowlist_missing_files "${relative_path}")
    endif()
endforeach()

if(h0_allowlist_missing_files)
    list(JOIN h0_allowlist_missing_files "\n  " h0_allowlist_missing_text)
    message(FATAL_ERROR
        "Phase H0 legacy core allowlist references missing files:\n  ${h0_allowlist_missing_text}")
endif()

file(GLOB h0_first_party_sources
    RELATIVE "${ZEROSLACK_SOURCE_DIR}"
    "${ZEROSLACK_SOURCE_DIR}/*.cpp"
    "${ZEROSLACK_SOURCE_DIR}/*.h"
)

set(h0_legacy_core_violations)
foreach(relative_path IN LISTS h0_first_party_sources)
    list(FIND H0_LEGACY_CORE_ALLOWLIST "${relative_path}" h0_allowlist_index)
    if(NOT h0_allowlist_index EQUAL -1)
        continue()
    endif()

    set(path "${ZEROSLACK_SOURCE_DIR}/${relative_path}")
    file(READ "${path}" content)
    foreach(pattern IN LISTS H0_LEGACY_CORE_PATTERNS)
        string(REGEX MATCH "${pattern}" match "${content}")
        if(match)
            list(APPEND h0_legacy_core_violations
                 "${relative_path}: ${pattern}")
        endif()
    endforeach()
endforeach()

if(h0_legacy_core_violations)
    list(JOIN h0_legacy_core_violations "\n  " h0_legacy_core_text)
    message(FATAL_ERROR
        "Phase H0 legacy core terms are forbidden outside the explicit transition allowlist:\n  ${h0_legacy_core_text}")
endif()

if(ZEROSLACK_PHASE_I_ZERO_TARGET)
    set(phase_i_zero_legacy_violations)
    foreach(relative_path IN LISTS h0_first_party_sources)
        set(path "${ZEROSLACK_SOURCE_DIR}/${relative_path}")
        file(READ "${path}" content)
        foreach(pattern IN LISTS PHASE_I_ZERO_LEGACY_TARGET_PATTERNS)
            string(REGEX MATCH "${pattern}" match "${content}")
            if(match)
                list(APPEND phase_i_zero_legacy_violations
                     "${relative_path}: ${pattern}")
            endif()
        endforeach()
    endforeach()

    if(phase_i_zero_legacy_violations)
        list(JOIN phase_i_zero_legacy_violations "\n  " phase_i_zero_legacy_text)
        message(FATAL_ERROR
            "Phase I zero legacy target is enabled; collector/store legacy carrier terms must be gone from core source:\n  ${phase_i_zero_legacy_text}")
    endif()
endif()

set(f3_removed_compatibility_violations)
foreach(entry IN LISTS F3_REMOVED_COMPATIBILITY_PATTERNS)
    string(REPLACE "|" ";" parts "${entry}")
    list(GET parts 0 relative_path)
    set(patterns ${parts})
    list(REMOVE_AT patterns 0)
    set(path "${ZEROSLACK_SOURCE_DIR}/${relative_path}")
    if(NOT EXISTS "${path}")
        continue()
    endif()
    file(READ "${path}" content)
    foreach(pattern IN LISTS patterns)
        string(REGEX MATCH "${pattern}" match "${content}")
        if(match)
            list(APPEND f3_removed_compatibility_violations
                 "${relative_path}: ${pattern}")
        endif()
    endforeach()
endforeach()

if(f3_removed_compatibility_violations)
    list(JOIN f3_removed_compatibility_violations "\n  " f3_removed_text)
    message(FATAL_ERROR
        "Removed Phase F3 compatibility surfaces must not return:\n  ${f3_removed_text}")
endif()
