set(missing_files)
set(violations)
foreach(relative_path IN LISTS PROTECTED_BOUNDARY_FILES)
    set(path "${ZEROSLACK_SOURCE_DIR}/${relative_path}")
    if(NOT EXISTS "${path}")
        list(APPEND missing_files "${relative_path}")
        continue()
    endif()

    file(READ "${path}" content)
    string(REGEX MATCHALL
        "\\.(symbolId|symbolType|moduleScope|dataType)([^A-Za-z0-9_]|$)"
        field_matches
        "${content}")
    string(REGEX MATCHALL
        "[A-Za-z0-9_]+\\.symbol\\.symbolName([^A-Za-z0-9_]|$)"
        symbol_payload_name_matches
        "${content}")
    string(REGEX MATCHALL
        "(^|[^A-Za-z0-9_])sym_type_e([^A-Za-z0-9_]|$)|(^|[^A-Za-z0-9_])sym_list::sym_[A-Za-z0-9_]+([^A-Za-z0-9_]|$)"
        enum_matches
        "${content}")
    string(REGEX MATCHALL
        "(^|[^A-Za-z0-9_])(findSymbolId|getSymbolById|getRelationships)[ \t\r\n]*\\("
        int_id_api_matches
        "${content}")

    if(field_matches OR symbol_payload_name_matches OR enum_matches OR int_id_api_matches)
        list(APPEND violations "${relative_path}")
    endif()
endforeach()

if(missing_files)
    list(JOIN missing_files "\n  " missing_file_text)
    message(FATAL_ERROR
        "Legacy field guard references missing protected boundary files:\n  ${missing_file_text}")
endif()

if(violations)
    list(JOIN violations "\n  " violation_text)
    message(FATAL_ERROR
        "Legacy SymbolInfo product-policy fields, direct embedded SymbolInfo display names, or int-id query APIs are not allowed in protected UI/coordinator/scheduler boundaries:\n  ${violation_text}")
endif()

set(record_first_missing_files)
set(record_first_violations)
foreach(relative_path IN LISTS RECORD_FIRST_METADATA_FILES)
    set(path "${ZEROSLACK_SOURCE_DIR}/${relative_path}")
    if(NOT EXISTS "${path}")
        list(APPEND record_first_missing_files "${relative_path}")
        continue()
    endif()

    file(READ "${path}" content)
    string(REGEX MATCHALL
        "\\.(moduleScope|dataType)([^A-Za-z0-9_]|$)"
        record_first_field_matches
        "${content}")

    if(record_first_field_matches)
        list(APPEND record_first_violations "${relative_path}")
    endif()
endforeach()

if(record_first_missing_files)
    list(JOIN record_first_missing_files "\n  " record_first_missing_text)
    message(FATAL_ERROR
        "Record-first metadata guard references missing migrated files:\n  ${record_first_missing_text}")
endif()

if(record_first_violations)
    list(JOIN record_first_violations "\n  " record_first_violation_text)
    message(FATAL_ERROR
        "Migrated semantic service/query files must not read SymbolInfo moduleScope/dataType directly:\n  ${record_first_violation_text}")
endif()

set(stable_key_missing_files)
set(stable_key_violations)
foreach(relative_path IN LISTS STABLE_KEY_MIGRATED_SERVICE_FILES)
    set(path "${ZEROSLACK_SOURCE_DIR}/${relative_path}")
    if(NOT EXISTS "${path}")
        list(APPEND stable_key_missing_files "${relative_path}")
        continue()
    endif()

    file(READ "${path}" content)
    string(REGEX MATCHALL
        "findSymbolId[ \t\r\n]*\\([^\\)]*symbolStableKey"
        stable_key_find_id_matches
        "${content}")
    string(REGEX MATCHALL
        "(^|[^A-Za-z0-9_])(findSymbolId|getSymbolById)[ \t\r\n]*\\("
        stable_key_int_id_matches
        "${content}")
    string(REGEX MATCHALL
        "(^|[^A-Za-z0-9_])getRelationships[ \t\r\n]*\\("
        raw_relationship_matches
        "${content}")

    if(stable_key_find_id_matches OR stable_key_int_id_matches OR raw_relationship_matches)
        list(APPEND stable_key_violations "${relative_path}")
    endif()
endforeach()

if(stable_key_missing_files)
    list(JOIN stable_key_missing_files "\n  " stable_key_missing_text)
    message(FATAL_ERROR
        "Stable-key service guard references missing migrated files:\n  ${stable_key_missing_text}")
endif()

if(stable_key_violations)
    list(JOIN stable_key_violations "\n  " stable_key_violation_text)
    message(FATAL_ERROR
        "Stable-key migrated services must not resolve through int-id APIs or raw relationship queries:\n  ${stable_key_violation_text}")
endif()

set(record_metadata_missing_files)
set(record_metadata_violations)
foreach(relative_path IN LISTS RECORD_METADATA_HELPER_FILES)
    set(path "${ZEROSLACK_SOURCE_DIR}/${relative_path}")
    if(NOT EXISTS "${path}")
        list(APPEND record_metadata_missing_files "${relative_path}")
        continue()
    endif()

    file(READ "${path}" content)
    string(REGEX MATCHALL
        "\\.(rawCollectorKind)([^A-Za-z0-9_]|$)"
        record_metadata_raw_matches
        "${content}")

    if(record_metadata_raw_matches)
        list(APPEND record_metadata_violations "${relative_path}")
    endif()
endforeach()

if(record_metadata_missing_files)
    list(JOIN record_metadata_missing_files "\n  " record_metadata_missing_text)
    message(FATAL_ERROR
        "Semantic record metadata helper guard references missing files:\n  ${record_metadata_missing_text}")
endif()

if(record_metadata_violations)
    list(JOIN record_metadata_violations "\n  " record_metadata_violation_text)
    message(FATAL_ERROR
        "Migrated semantic service/query files must use semanticMetadataForSymbolRecord instead of reading rawCollectorKind directly:\n  ${record_metadata_violation_text}")
endif()

set(record_native_missing_files)
set(record_native_violations)
foreach(relative_path IN LISTS RECORD_NATIVE_SERVICE_FILES)
    set(path "${ZEROSLACK_SOURCE_DIR}/${relative_path}")
    if(NOT EXISTS "${path}")
        list(APPEND record_native_missing_files "${relative_path}")
        continue()
    endif()

    file(READ "${path}" content)
    string(REGEX MATCHALL
        "semanticSymbolInfoCarrier(sForRecords|ForRecord)?[ \t\r\n]*\\("
        record_native_carrier_matches
        "${content}")

    if(record_native_carrier_matches)
        list(APPEND record_native_violations "${relative_path}")
    endif()
endforeach()

if(record_native_missing_files)
    list(JOIN record_native_missing_files "\n  " record_native_missing_text)
    message(FATAL_ERROR
        "Record-native service guard references missing files:\n  ${record_native_missing_text}")
endif()

if(record_native_violations)
    list(JOIN record_native_violations "\n  " record_native_violation_text)
    message(FATAL_ERROR
        "Record-native services must not convert records back through SymbolInfo carrier helpers:\n  ${record_native_violation_text}")
endif()

set(h0_allowlist_missing_files)
foreach(relative_path IN LISTS H0_LEGACY_CORE_ALLOWLIST)
    set(path "${ZEROSLACK_SOURCE_DIR}/${relative_path}")
    if(NOT EXISTS "${path}")
        list(APPEND h0_allowlist_missing_files "${relative_path}")
    endif()
endforeach()

if(h0_allowlist_missing_files)
    list(JOIN h0_allowlist_missing_files "\n  " h0_allowlist_missing_text)
    message(FATAL_ERROR
        "Phase H0 legacy core allowlist references missing files:\n  ${h0_allowlist_missing_text}")
endif()

file(GLOB h0_first_party_sources
    RELATIVE "${ZEROSLACK_SOURCE_DIR}"
    "${ZEROSLACK_SOURCE_DIR}/*.cpp"
    "${ZEROSLACK_SOURCE_DIR}/*.h"
)

set(h0_legacy_core_violations)
foreach(relative_path IN LISTS h0_first_party_sources)
    list(FIND H0_LEGACY_CORE_ALLOWLIST "${relative_path}" h0_allowlist_index)
    if(NOT h0_allowlist_index EQUAL -1)
        continue()
    endif()

    set(path "${ZEROSLACK_SOURCE_DIR}/${relative_path}")
    file(READ "${path}" content)
    foreach(pattern IN LISTS H0_LEGACY_CORE_PATTERNS)
        string(REGEX MATCH "${pattern}" match "${content}")
        if(match)
            list(APPEND h0_legacy_core_violations
                 "${relative_path}: ${pattern}")
        endif()
    endforeach()
endforeach()

if(h0_legacy_core_violations)
    list(JOIN h0_legacy_core_violations "\n  " h0_legacy_core_text)
    message(FATAL_ERROR
        "Phase H0 legacy core terms are forbidden outside the explicit transition allowlist:\n  ${h0_legacy_core_text}")
endif()

set(f3_removed_compatibility_violations)
foreach(entry IN LISTS F3_REMOVED_COMPATIBILITY_PATTERNS)
    string(REPLACE "|" ";" parts "${entry}")
    list(GET parts 0 relative_path)
    set(patterns ${parts})
    list(REMOVE_AT patterns 0)
    set(path "${ZEROSLACK_SOURCE_DIR}/${relative_path}")
    if(NOT EXISTS "${path}")
        list(APPEND f3_removed_compatibility_violations
             "${relative_path} (missing file)")
        continue()
    endif()
    file(READ "${path}" content)
    foreach(pattern IN LISTS patterns)
        string(REGEX MATCH "${pattern}" match "${content}")
        if(match)
            list(APPEND f3_removed_compatibility_violations
                 "${relative_path}: ${pattern}")
        endif()
    endforeach()
endforeach()

if(f3_removed_compatibility_violations)
    list(JOIN f3_removed_compatibility_violations "\n  " f3_removed_text)
    message(FATAL_ERROR
        "Removed Phase F3 compatibility surfaces must not return:\n  ${f3_removed_text}")
endif()
