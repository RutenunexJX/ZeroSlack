    "src/semantic/semanticindex.h|struct[ \t\r\n]+SemanticRelationshipResult[ \t\r\n]*\\{[^}]*sym_list::SymbolInfo[ \t\r\n]+toSymbol"
    "src/semantic/semanticindex.h|struct[ \t\r\n]+SemanticDefinitionResult[ \t\r\n]*\\{[^}]*sym_list::SymbolInfo[ \t\r\n]+symbol"
    "src/semantic/semanticindexlookup.cpp|best\\.symbol[ \t\r\n]*="
    "src/semantic/signaljourneyservice.cpp|definition\\.symbol[^A-Za-z0-9_]"
    "src/insights/fsmgraphservice.cpp|definition\\.symbol[^A-Za-z0-9_]"
    "src/semantic/semanticindexrelationships.cpp|relationshipEndpointSymbol"
    "src/semantic/semanticindexrelationships.cpp|symbolByLocalHandle"
    "src/semantic/hierarchyservice.cpp|rel\\.fromSymbol[^A-Za-z0-9_]"
    "src/semantic/hierarchyservice.cpp|rel\\.toSymbol[^A-Za-z0-9_]"
    "semanticindexcompletionrelationships.cpp|relationship\\.fromSymbol[^A-Za-z0-9_]"
    "semanticindexcompletionrelationships.cpp|relationship\\.toSymbol[^A-Za-z0-9_]"
    "src/semantic/semanticindexmodulecontext.cpp|relationship\\.toSymbol[^A-Za-z0-9_]"
    "src/semantic/signaljourneyservice.cpp|relationship\\.fromSymbol[^A-Za-z0-9_]"
    "src/semantic/signaljourneyservice.cpp|relationship\\.toSymbol[^A-Za-z0-9_]"
    "src/insights/fsmgraphservice.cpp|SymbolTaxonomy::isModuleDeclaration[ \t\r\n]*\\([ \t\r\n]*definition\\.symbol[ \t\r\n,\\)]"
    "src/semantic/signaljourneyservice.cpp|isJourneyDeclaration[ \t\r\n]*\\([ \t\r\n]*definition\\.symbol[ \t\r\n,\\)]"
    "semanticindexcompletionrelationships.cpp|symbolStableKeyForSymbol[ \t\r\n]*\\([ \t\r\n]*definition\\.symbol[ \t\r\n,\\)]"
    "src/semantic/signaljourneyservice.h|signalSymbolId"
    "src/semantic/signaljourneyservice.h|isJourneyDeclaration[ \t\r\n]*\\([^\\)]*sym_list::SymbolInfo"
    "src/semantic/signaljourneyservice.h|isInterfaceConnectionPeer[ \t\r\n]*\\([^\\)]*sym_list::SymbolInfo"
    "src/semantic/signaljourneyservice.cpp|signalSymbolId|getSymbolById[ \t\r\n]*\\("
    "src/semantic/signaljourneyservice.cpp|getRelationshipResults[ \t\r\n]*\\([^\\)]*symbolId"
    "src/semantic/signaljourneyservice.cpp|signal\\.symbolId"
    "src/semantic/signaljourneyservice.cpp|symbol\\.symbolId[ \t\r\n]*<"
)

set(missing_files)
set(violations)
foreach(relative_path IN LISTS PROTECTED_BOUNDARY_FILES)
    set(path "${ZEROSLACK_SOURCE_DIR}/${relative_path}")
    if(NOT EXISTS "${path}")
        list(APPEND missing_files "${relative_path}")
        continue()
    endif()

    file(READ "${path}" content)
    string(REGEX MATCHALL
        "\\.(symbolId|symbolType|moduleScope|dataType)([^A-Za-z0-9_]|$)"
        field_matches
        "${content}")
    string(REGEX MATCHALL
        "[A-Za-z0-9_]+\\.symbol\\.symbolName([^A-Za-z0-9_]|$)"
        symbol_payload_name_matches
        "${content}")
    string(REGEX MATCHALL
        "(^|[^A-Za-z0-9_])sym_type_e([^A-Za-z0-9_]|$)|(^|[^A-Za-z0-9_])sym_list::sym_[A-Za-z0-9_]+([^A-Za-z0-9_]|$)"
        enum_matches
        "${content}")
    string(REGEX MATCHALL
        "(^|[^A-Za-z0-9_])(findSymbolId|getSymbolById|getRelationships)[ \t\r\n]*\\("
        int_id_api_matches
        "${content}")

    if(field_matches OR symbol_payload_name_matches OR enum_matches OR int_id_api_matches)
        list(APPEND violations "${relative_path}")
    endif()
endforeach()

if(missing_files)
    list(JOIN missing_files "\n  " missing_file_text)
    message(FATAL_ERROR
        "Legacy field guard references missing protected boundary files:\n  ${missing_file_text}")
endif()

if(violations)
    list(JOIN violations "\n  " violation_text)
    message(FATAL_ERROR
        "Legacy SymbolInfo product-policy fields, direct embedded SymbolInfo display names, or int-id query APIs are not allowed in protected UI/coordinator/scheduler boundaries:\n  ${violation_text}")
endif()

