set(FULL_AUDIT_PASSIVE_FULL_SCAN_PATTERNS
    "src/semantic/semanticindexcompletiontypequeries.cpp|getSymbolRecords[ 	\r\n]*\\([ 	\r\n]*\\)"
    "src/app/mainwindow.cpp|activeEditorPassiveRefreshTimer->start"
    "src/app/mainwindow.cpp|kMaxPassiveSemanticDecorationCharacters"
    "src/app/mainwindow.cpp|kMaxPassiveGhostAnnotationCharacters"
    "src/editor/editorruntime.cpp|kMaxPassiveGhostAnnotationCharacters"
)

set(full_audit_passive_full_scan_violations)
foreach(entry IN LISTS FULL_AUDIT_PASSIVE_FULL_SCAN_PATTERNS)
    string(REPLACE "|" ";" parts "${entry}")
    list(GET parts 0 relative_path)
    list(GET parts 1 pattern)
    set(path "${ZEROSLACK_SOURCE_DIR}/${relative_path}")
    if(NOT EXISTS "${path}")
        message(FATAL_ERROR
            "Passive full-scan guard references missing file: ${relative_path}")
    endif()
    file(READ "${path}" content)
    string(REGEX MATCH "${pattern}" match "${content}")
    if(match)
        list(APPEND full_audit_passive_full_scan_violations
             "${relative_path}: ${pattern}")
    endif()
endforeach()

if(full_audit_passive_full_scan_violations)
    list(JOIN full_audit_passive_full_scan_violations
         "\n  "
         full_audit_passive_full_scan_text)
    message(FATAL_ERROR
        "Passive UI paths must not use unbounded queries, debounce, or size-based feature shutdown:\n  ${full_audit_passive_full_scan_text}")
endif()

