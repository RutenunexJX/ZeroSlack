set(relationship_perf_path
    "${ZEROSLACK_SOURCE_DIR}/test_sv/relationship_perf_test.cpp")
file(READ "${relationship_perf_path}" relationship_perf_content)
set(full_audit_relationship_perf_missing)
foreach(pattern IN LISTS FULL_AUDIT_RELATIONSHIP_PERF_REQUIRED_PATTERNS)
    string(REGEX MATCH "${pattern}" match "${relationship_perf_content}")
    if(NOT match)
        list(APPEND full_audit_relationship_perf_missing "${pattern}")
    endif()
endforeach()

if(full_audit_relationship_perf_missing)
    list(JOIN full_audit_relationship_perf_missing
         "\n  "
         full_audit_relationship_perf_text)
    message(FATAL_ERROR
        "relationship_perf_test must reject empty, partial, or unpublished results; missing runtime validation:\n  ${full_audit_relationship_perf_text}")
endif()

