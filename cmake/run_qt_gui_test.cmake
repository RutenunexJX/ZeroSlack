# Persist Qt results independently of Windows stdout handle availability.
foreach(required QT_TEST_NAME QT_TEST_EXECUTABLE QT_TEST_LOG_ROOT)
    if(NOT DEFINED ${required} OR "${${required}}" STREQUAL "")
        message(FATAL_ERROR "TEST INFRASTRUCTURE ERROR [qt_gui/arguments]: missing ${required}")
    endif()
endforeach()
if(DEFINED ENV{ZEROSLACK_QT_TEST_LOG_ROOT} AND NOT "$ENV{ZEROSLACK_QT_TEST_LOG_ROOT}" STREQUAL "")
    set(QT_TEST_LOG_ROOT "$ENV{ZEROSLACK_QT_TEST_LOG_ROOT}")
endif()
string(TIMESTAMP started "%Y%m%dT%H%M%S" UTC)
string(RANDOM LENGTH 16 ALPHABET 0123456789abcdef invocation)
set(report "${QT_TEST_LOG_ROOT}/${QT_TEST_NAME}/${started}-${invocation}")
message(STATUS "Qt GUI invocation: test=${QT_TEST_NAME}; executable=${QT_TEST_EXECUTABLE}; arguments=${QT_TEST_ARGUMENTS}; phase=preflight")
message(STATUS "Qt GUI evidence: ${report}")
function(qt_evidence_error stage detail)
    message("TEST INFRASTRUCTURE ERROR [qt_gui/${stage}]: ${detail}")
    if(report_ready)
        file(WRITE "${report}/infrastructure-error.txt" "stage=${stage}\n${detail}\n")
        file(WRITE "${report}/phase.txt" "infrastructure_error\n")
    endif()
    message(FATAL_ERROR "${QT_TEST_NAME}: evidence failure in ${stage}; ${report}")
endfunction()
execute_process(COMMAND "${CMAKE_COMMAND}" -E make_directory "${report}"
    RESULT_VARIABLE directory_result ERROR_VARIABLE directory_error)
if(NOT "${directory_result}" STREQUAL "0")
    qt_evidence_error(directory "${directory_result}: ${directory_error}")
endif()
execute_process(COMMAND "${CMAKE_COMMAND}" -E touch "${report}/write-check"
    RESULT_VARIABLE write_result ERROR_VARIABLE write_error)
if(NOT "${write_result}" STREQUAL "0")
    qt_evidence_error(write_preflight "${write_result}: ${write_error}")
endif()
set(report_ready TRUE)
file(WRITE "${report}/phase.txt" "preparing\n")
file(WRITE "${report}/invocation.txt"
    "test=${QT_TEST_NAME}\nexecutable=${QT_TEST_EXECUTABLE}\narguments=${QT_TEST_ARGUMENTS}\n"
    "startedUtc=${started}\nplatform=$ENV{QT_QPA_PLATFORM}\nscaleFactor=$ENV{QT_SCALE_FACTOR}\n")
if(NOT EXISTS "${QT_TEST_EXECUTABLE}" OR IS_DIRECTORY "${QT_TEST_EXECUTABLE}")
    qt_evidence_error(executable_preflight "Executable is not a file: ${QT_TEST_EXECUTABLE}; child not launched")
endif()
file(WRITE "${report}/phase.txt" "running\n")
execute_process(
    COMMAND "${QT_TEST_EXECUTABLE}" ${QT_TEST_ARGUMENTS}
        -o "${report}/result.xml,junitxml" -o "${report}/test.log,txt"
    RESULT_VARIABLE result
    OUTPUT_FILE "${report}/stdout.log"
    ERROR_FILE "${report}/stderr.log")
# Emit the raw child result before any finalization that could itself fail.
message(STATUS "Qt child result: ${QT_TEST_NAME}: ${result}")
file(WRITE "${report}/phase.txt" "finalizing\n")
file(WRITE "${report}/exit-code.txt" "${result}\n")
if("${result}" STREQUAL "0")
    foreach(log test.log result.xml)
        if(NOT EXISTS "${report}/${log}")
            qt_evidence_error(qt_output "Child returned 0 but ${log} is missing")
        endif()
        file(SIZE "${report}/${log}" log_size)
        if(log_size EQUAL 0)
            qt_evidence_error(qt_output "Child returned 0 but ${log} is empty")
        endif()
    endforeach()
endif()
if(EXISTS "${report}/test.log")
    file(STRINGS "${report}/test.log" summary ENCODING UTF-8
        REGEX "^(PASS |FAIL!|SKIP |QFATAL|Totals:|.*failure location|[ ]*Loc:|[ ]*Actual|[ ]*Expected)")
    file(WRITE "${report}/summary.txt" "")
    foreach(line IN LISTS summary)
        message("${line}")
        file(APPEND "${report}/summary.txt" "${line}\n")
    endforeach()
else()
    message(STATUS "${QT_TEST_NAME}: no Qt text output; process result remains ${result}")
endif()
if(NOT "${result}" STREQUAL "0")
    file(WRITE "${report}/phase.txt" "process_failed\n")
    foreach(log test.log stdout.log stderr.log)
        if(EXISTS "${report}/${log}")
            file(READ "${report}/${log}" contents)
            message("${log}:\n${contents}")
        endif()
    endforeach()
    message(FATAL_ERROR "${QT_TEST_NAME}: process exit code ${result}; evidence: ${report}")
endif()
file(WRITE "${report}/phase.txt" "complete\n")
message(STATUS "${QT_TEST_NAME}: process exit code ${result}")
