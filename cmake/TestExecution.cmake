include_guard(GLOBAL)
find_package(Python REQUIRED COMPONENTS Interpreter)
find_package(Git REQUIRED)
get_filename_component(ZEROSLACK_GIT_BIN_DIR "${GIT_EXECUTABLE}" DIRECTORY)
file(SHA256 "${GIT_EXECUTABLE}" ZEROSLACK_GIT_SHA256)
set(ZEROSLACK_TEST_POLICY "${CMAKE_SOURCE_DIR}/test_sv/test-execution-policy.json")
file(READ "${ZEROSLACK_TEST_POLICY}" zeroslack_policy_json)
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${ZEROSLACK_TEST_POLICY}")

function(zeroslack_json_quote output value)
    string(REPLACE "\\" "\\\\" value "${value}")
    string(REPLACE "\"" "\\\"" value "${value}")
    string(REPLACE "\n" "\\n" value "${value}")
    string(REPLACE "\r" "\\r" value "${value}")
    set(${output} "\"${value}\"" PARENT_SCOPE)
endfunction()

# Component CMake files retain their public registration calls. Capture them at
# the shared boundary without changing their component or test implementations.
function(add_test)
    cmake_parse_arguments(PARSE_ARGV 0 test "" "NAME;WORKING_DIRECTORY" "COMMAND;CONFIGURATIONS")
    if(NOT test_NAME OR NOT test_COMMAND OR test_UNPARSED_ARGUMENTS)
        message(FATAL_ERROR "Unsupported managed test registration: ${ARGV}")
    endif()
    set(command_json "")
    foreach(argument IN LISTS test_COMMAND)
        if(TARGET "${argument}")
            get_target_property(kind "${argument}" TYPE)
            if(kind STREQUAL "EXECUTABLE")
                set(argument "$<TARGET_FILE:${argument}>")
            endif()
        endif()
        zeroslack_json_quote(quoted "${argument}")
        string(APPEND command_json "${quoted},")
    endforeach()
    string(REGEX REPLACE ",$" "" command_json "${command_json}")
    set(spec "${CMAKE_BINARY_DIR}/Testing/ManagedCommands/${test_NAME}.json")
    file(GENERATE OUTPUT "${spec}" CONTENT
        "{\"name\":\"${test_NAME}\",\"source\":\"${CMAKE_SOURCE_DIR}\",\"build\":\"${CMAKE_BINARY_DIR}\",\"command\":[${command_json}]}\n")
    set(extra)
    if(test_WORKING_DIRECTORY)
        list(APPEND extra WORKING_DIRECTORY "${test_WORKING_DIRECTORY}")
    endif()
    if(test_CONFIGURATIONS)
        list(APPEND extra CONFIGURATIONS ${test_CONFIGURATIONS})
    endif()
    _add_test(NAME "${test_NAME}" COMMAND "${Python_EXECUTABLE}"
        "${CMAKE_SOURCE_DIR}/scripts/test_policy.py" invoke
        --policy "${ZEROSLACK_TEST_POLICY}" --spec "${spec}" ${extra})
    get_property(finalizer_scheduled DIRECTORY PROPERTY ZEROSLACK_TEST_FINALIZER_SCHEDULED)
    if(NOT finalizer_scheduled)
        set_property(DIRECTORY PROPERTY ZEROSLACK_TEST_FINALIZER_SCHEDULED TRUE)
        cmake_language(DEFER CALL zeroslack_finalize_directory_policy)
    endif()
endfunction()

function(zeroslack_collect_targets directory output)
    get_property(targets DIRECTORY "${directory}" PROPERTY BUILDSYSTEM_TARGETS)
    get_property(children DIRECTORY "${directory}" PROPERTY SUBDIRECTORIES)
    foreach(child IN LISTS children)
        zeroslack_collect_targets("${child}" nested)
        list(APPEND targets ${nested})
    endforeach()
    set(${output} "${targets}" PARENT_SCOPE)
endfunction()

function(zeroslack_test_uses_qt target visited output)
    set(${output} false PARENT_SCOPE)
    if(target MATCHES "^Qt(6)?::")
        set(${output} true PARENT_SCOPE)
        return()
    endif()
    if(NOT TARGET "${target}" OR target IN_LIST visited)
        return()
    endif()
    list(APPEND visited "${target}")
    foreach(property LINK_LIBRARIES INTERFACE_LINK_LIBRARIES)
        get_target_property(links "${target}" "${property}")
        foreach(link IN LISTS links)
            if(link MATCHES "^\\$<LINK_ONLY:([^>]+)>$")
                set(link "${CMAKE_MATCH_1}")
            endif()
            zeroslack_test_uses_qt("${link}" "${visited}" uses_qt)
            if(uses_qt)
                set(${output} true PARENT_SCOPE)
                return()
            endif()
        endforeach()
    endforeach()
endfunction()

function(zeroslack_finalize_directory_policy)
    string(JSON count LENGTH "${zeroslack_policy_json}" tests)
    math(EXPR last "${count}-1")
    get_property(registered DIRECTORY PROPERTY TESTS)
    foreach(index RANGE ${last})
        string(JSON name GET "${zeroslack_policy_json}" tests ${index} name)
        string(JSON timeout GET "${zeroslack_policy_json}" tests ${index} timeout)
        if(name IN_LIST registered)
            set_tests_properties("${name}" PROPERTIES TIMEOUT "${timeout}")
            get_filename_component(compiler_bin "${CMAKE_CXX_COMPILER}" DIRECTORY)
            set_property(TEST "${name}" APPEND PROPERTY ENVIRONMENT_MODIFICATION
                "PATH=path_list_prepend:$<TARGET_FILE_DIR:Qt6::Core>"
                "PATH=path_list_prepend:${compiler_bin}"
                "QT_PLUGIN_PATH=set:$<TARGET_FILE_DIR:Qt6::Core>/../plugins")
        endif()
    endforeach()
endfunction()

function(zeroslack_finalize_test_policy)
    string(JSON count LENGTH "${zeroslack_policy_json}" tests)
    math(EXPR last "${count}-1")
    set(mapped_targets)
    foreach(index RANGE ${last})
        string(JSON target ERROR_VARIABLE no_target GET "${zeroslack_policy_json}" tests ${index} target)
        if(NOT no_target)
            list(APPEND mapped_targets "${target}")
        endif()
    endforeach()
    zeroslack_collect_targets("${CMAKE_SOURCE_DIR}" all_targets)
    set(target_json "")
    foreach(target IN LISTS all_targets)
        get_target_property(kind "${target}" TYPE)
        if(NOT kind STREQUAL "EXECUTABLE")
            continue()
        endif()
        get_target_property(sources "${target}" SOURCES)
        set(is_test false)
        if(target IN_LIST mapped_targets OR sources MATCHES "(^|;|/)test_sv/" OR sources MATCHES "(^|;|/)tests/")
            set(is_test true)
        endif()
        set(managed_settings false)
        if(is_test)
            zeroslack_test_uses_qt("${target}" "" managed_settings)
        endif()
        if(managed_settings)
            target_sources("${target}" PRIVATE "${CMAKE_SOURCE_DIR}/scripts/managed_test_profile.cpp")
            set_property(TARGET "${target}" APPEND PROPERTY LINK_LIBRARIES Qt6::Core)
        endif()
        string(APPEND target_json "{\"name\":\"${target}\",\"type\":\"${kind}\",\"artifact\":\"$<TARGET_FILE:${target}>\",\"testTarget\":${is_test},\"managedSettings\":${managed_settings}},")
    endforeach()
    string(REGEX REPLACE ",$" "" target_json "${target_json}")
    file(GENERATE OUTPUT "${CMAKE_BINARY_DIR}/managed-test-targets.json" CONTENT "[${target_json}]\n")
    set(configuration_json "")
    foreach(key IN ITEMS BUILD_TESTING CMAKE_BUILD_TYPE ZEROSLACK_ENABLE_ELA ZEROSLACK_CLI_ONLY ZEROSLACK_SELF_CONTAINED_FIXTURES
            ZEROSLACK_TEST_REAL_NATIVE_COMPONENTS ZEROSLACK_TEST_QUESTA_EXECUTABLE SuiteApp_FOUND)
        zeroslack_json_quote(value "${${key}}")
        string(APPEND configuration_json "\"${key}\":${value},")
    endforeach()
    string(REGEX REPLACE ",$" "" configuration_json "${configuration_json}")
    zeroslack_json_quote(git_path "${GIT_EXECUTABLE}")
    file(GENERATE OUTPUT "${CMAKE_BINARY_DIR}/managed-test-config.json" CONTENT
        "{\"source\":\"${CMAKE_SOURCE_DIR}\",\"build\":\"${CMAKE_BINARY_DIR}\",\"policy\":\"${ZEROSLACK_TEST_POLICY}\",\"targets\":\"${CMAKE_BINARY_DIR}/managed-test-targets.json\",\"ctest\":\"${CMAKE_CTEST_COMMAND}\",\"ninja\":\"${CMAKE_MAKE_PROGRAM}\",\"generator\":\"${CMAKE_GENERATOR}\",\"qtBin\":\"${QT_INSTALL_PREFIX}/bin\",\"compilerBin\":\"${ZEROSLACK_COMPILER_BIN_DIR}\",\"runtimeTools\":{\"git\":{\"path\":${git_path},\"sha256\":\"${ZEROSLACK_GIT_SHA256}\"}},\"configuration\":{${configuration_json}}}\n")
endfunction()
