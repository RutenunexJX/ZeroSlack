{
  "schemaVersion": 1,
  "templates": [
    {
      "id": "user:zsgroup",
      "command": "/zsgroup",
      "label": "Waveform group",
      "description": "Group the following signal declaration in Questa",
      "body": "/* zs_group = user_interface_xxx */\n",
      "slots": [
        {"name": "group", "start": 14, "length": 18, "tabStop": 1, "visibleWhenEmpty": true, "input": {"kind": "WaveGroup"}}
      ],
      "editor": {"kind": "snippet", "context": "codeLine", "extensions": ["sv", "svh", "v", "vh"]}
    },
    {
      "id": "user:timescale",
      "command": "/timescale",
      "label": "Timescale 1ns / 1ps",
      "description": "Insert a Verilog timescale directive",
      "body": "`timescale 1ns / 1ps"
    },
    {
      "id": "user:signals",
      "command": "/signals",
      "label": "Module signals",
      "description": "Create internal signals from a module's ports",
      "editor": {"kind": "moduleDeclarations", "mode": "signals", "context": "module", "extensions": ["sv", "svh", "v", "vh"]}
    },
    {
      "id": "user:parameters",
      "command": "/parameters",
      "label": "Module parameters",
      "description": "Create parameter declarations from a module",
      "editor": {"kind": "moduleDeclarations", "mode": "parameters", "context": "module", "extensions": ["sv", "svh", "v", "vh"]}
    }
  ]
}
