        "operations": [
          {
            "op": "declareSignals",
            "target": "definitions",
            "reuse": "explicit",
            "namePattern": "${instance}_${port}",
            "label": "DUT signals"
          },
          {
            "op": "instantiateModule",
            "target": "instances",
            "bindings": "named"
          }
        ]
      }
    }
  ]
